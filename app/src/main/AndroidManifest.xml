<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <uses-sdk tools:overrideLibrary="com.nothing.thirdparty" />

    <!-- Signature-level permission for secure app-lock broadcasts -->
    <permission
        android:name="com.nothingxpert.permission.APP_LOCK"
        android:protectionLevel="signature" />

    <!-- Allow listing launcher apps for App Lock picker -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NothingXpertApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NothingXpert">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/module_scope" />

        <!-- ML Kit subject segmentation auto-download -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <!-- Glyph SDK test key (debug mode enabled via root) -->
        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/pref_category_lockscreen"
            android:configChanges="locale|layoutDirection" />

        <activity
            android:name=".MiscSettingsActivity"
            android:exported="false"
            android:label="@string/pref_category_misc"
            android:configChanges="locale|layoutDirection" />

        <activity
            android:name=".StatusBarSettingsActivity"
            android:exported="false"
            android:label="@string/pref_category_status_bar"
            android:configChanges="locale|layoutDirection" />

        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:label="@string/pref_category_apps"
            android:configChanges="locale|layoutDirection" />

        <activity
            android:name=".AppLockSettingsActivity"
            android:exported="false"
            android:label="@string/pref_category_apps"
            android:configChanges="locale|layoutDirection" />

        <activity
            android:name=".UndismissableNotifsSettingsActivity"
            android:exported="false"
            android:label="@string/pref_undismissable_notifs_title"
            android:configChanges="locale|layoutDirection" />

        <activity
            android:name=".LockScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.nothingxpert.lock"
            android:finishOnTaskLaunch="true" />

        <activity
            android:name=".GlyphsActivity"
            android:exported="false"
            android:label="@string/pref_category_glyphs"
            android:configChanges="locale|layoutDirection" />

        <activity
            android:name=".GlyphNotifSettingsActivity"
            android:exported="false"
            android:label="@string/glyph_notif_title"
            android:configChanges="locale|layoutDirection" />

        <service
            android:name=".GlyphNotificationService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name=".RemotePrefProvider"
            android:authorities="com.nothingxpert"
            android:exported="true" />

        <receiver
            android:name=".RefreshRateBootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
