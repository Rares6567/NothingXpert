<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LSPosed module scope -->
    <string-array name="module_scope">
        <item>android</item>
        <item>com.android.systemui</item>
        <item>com.nothing.launcher</item>
        <item>com.google.android.inputmethod.latin</item>
    </string-array>

    <!-- Maximum refresh rate entries -->
    <string-array name="max_refresh_rate_entries">
        <item>@string/max_refresh_rate_system_default</item>
        <item>@string/max_refresh_rate_60</item>
        <item>@string/max_refresh_rate_90</item>
        <item>@string/max_refresh_rate_120</item>
    </string-array>

    <string-array name="max_refresh_rate_values">
        <item>default</item>
        <item>60</item>
        <item>90</item>
        <item>120</item>
    </string-array>

    <!-- Volume long-press action entries (display names) -->
    <string-array name="volume_action_entries">
        <item>@string/volume_action_default</item>
        <item>@string/volume_action_none</item>
        <item>@string/volume_action_flashlight</item>
        <item>@string/volume_action_play_pause</item>
        <item>@string/volume_action_next</item>
        <item>@string/volume_action_previous</item>
    </string-array>

    <!-- Volume long-press action values -->
    <string-array name="volume_action_values">
        <item>0</item>
        <item>-1</item>
        <item>1</item>
        <item>5</item>
        <item>6</item>
        <item>7</item>
    </string-array>

    <!-- Floating window size entries -->
    <string-array name="floating_window_size_entries">
        <item>@string/floating_window_size_small</item>
        <item>@string/floating_window_size_medium</item>
        <item>@string/floating_window_size_large</item>
    </string-array>

    <!-- Floating window size values -->
    <string-array name="floating_window_size_values">
        <item>small</item>
        <item>medium</item>
        <item>large</item>
    </string-array>

</resources>
