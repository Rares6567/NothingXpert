<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:visibility="visible">

	<com.nothingxpert.ui.preferences.MaterialPreferenceCategory
		android:layout="@layout/custom_preference_category"
		android:title="@string/pref_category_misc"
		app:iconSpaceReserved="false">

		<com.nothingxpert.ui.preferences.MaterialSwitchPreference
			android:defaultValue="false"
			android:key="pref_allow_secure_screenshot"
			android:summaryOn="@string/pref_allow_secure_summary"
			android:summaryOff="@string/pref_allow_secure_summary"
			android:title="@string/pref_allow_secure_title"
			app:iconSpaceReserved="false" />

		<com.nothingxpert.ui.preferences.MaterialSwitchPreference
			android:defaultValue="false"
			android:key="pref_volume_longpress_tracks"
			android:summaryOn="@string/pref_volume_tracks_summary"
			android:summaryOff="@string/pref_volume_tracks_summary"
			android:title="@string/pref_volume_tracks_title"
			app:iconSpaceReserved="false" />

	</com.nothingxpert.ui.preferences.MaterialPreferenceCategory>

</PreferenceScreen>
