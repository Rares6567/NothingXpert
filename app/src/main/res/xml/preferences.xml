<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:visibility="visible">

	<com.nothingxpert.ui.preferences.MaterialPreferenceCategory
		android:layout="@layout/custom_preference_category"
		android:title="@string/pref_category_lockscreen"
		app:iconSpaceReserved="false">

		<com.nothingxpert.ui.preferences.MaterialSwitchPreference
			android:defaultValue="false"
			android:key="pref_single_tap_sleep"
			android:summaryOff="@string/general_off"
			android:summaryOn="@string/general_on"
			android:title="@string/pref_single_tap_sleep_title"
			app:iconSpaceReserved="false" />

		<com.nothingxpert.ui.preferences.MaterialSwitchPreference
			android:defaultValue="false"
			android:key="pref_double_tap_wake"
			android:summaryOn="@string/pref_double_tap_wake_summary"
			android:summaryOff="@string/pref_double_tap_wake_summary"
			android:title="@string/pref_double_tap_wake_title"
			app:iconSpaceReserved="false" />

		<com.nothingxpert.ui.preferences.MaterialSwitchPreference
			android:defaultValue="false"
			android:key="pref_shuffle_pin"
			android:summaryOn="@string/pref_shuffle_pin_summary"
			android:summaryOff="@string/pref_shuffle_pin_summary"
			android:title="@string/pref_shuffle_pin_title"
			app:iconSpaceReserved="false" />

	</com.nothingxpert.ui.preferences.MaterialPreferenceCategory>

</PreferenceScreen>
