<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="visible">

    <com.nothingxpert.ui.preferences.MaterialPreferenceCategory
        android:layout="@layout/custom_preference_category"
        android:title="@string/pref_category_gestures"
        app:iconSpaceReserved="false">

        <com.nothingxpert.ui.preferences.MaterialSwitchPreference
            android:defaultValue="false"
            android:key="pref_status_bar_double_tap_sleep"
            android:summaryOff="@string/pref_status_bar_double_tap_summary"
            android:summaryOn="@string/pref_status_bar_double_tap_summary"
            android:title="@string/pref_status_bar_double_tap_title"
            app:iconSpaceReserved="false" />

    </com.nothingxpert.ui.preferences.MaterialPreferenceCategory>

</PreferenceScreen>
