<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_container_margin_side"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/app_lock_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_lock_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:fontFamily="@font/ndot57"
            android:letterSpacing="0.05"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/app_lock_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_lock_summary"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:fontFamily="@font/ndot57"
            android:letterSpacing="0.02"
            android:paddingBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="88dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
