<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceContainer">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_nothing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOTHING"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="@font/ndot57"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/title_xpert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XPERT"
                    android:textSize="40sp"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="@font/ndot57"
                    android:letterSpacing="0.02" />

            </LinearLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="24dp"
                android:paddingHorizontal="@dimen/ui_container_margin_side"
                android:clipToPadding="false">

                <!-- Main section -->
                <LinearLayout
                    android:id="@+id/section_main"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Lock Screen Category -->
                    <include
                        android:id="@+id/category_lockscreen"
                        layout="@layout/item_category_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp" />

                    <!-- Miscellaneous Category -->
                    <include
                        android:id="@+id/category_misc"
                        layout="@layout/item_category_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp" />

                    <!-- Apps Category -->
                    <include
                        android:id="@+id/category_apps"
                        layout="@layout/item_category_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- System Monitor (minimal NothingOS style) -->
                    <LinearLayout
                        android:id="@+id/system_monitor_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="28dp"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/ram_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ram_monitor_placeholder"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:fontFamily="@font/ndot57"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/cpu_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/cpu_monitor_placeholder"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:fontFamily="@font/ndot57"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/gpu_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/gpu_monitor_placeholder"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:fontFamily="@font/ndot57"
                            android:letterSpacing="0.08" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Options section -->
                <LinearLayout
                    android:id="@+id/section_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/options_menu_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:fontFamily="@font/ndot57"
                        android:letterSpacing="0.06" />

                    <LinearLayout
                        android:id="@+id/card_amoled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/container_mid"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginBottom="4dp"
                            android:orientation="vertical">

                            <TextView
                                android:text="@string/option_amoled_title"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:fontFamily="@font/ndot57"
                                android:letterSpacing="0.04"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:text="@string/option_amoled_summary"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"
                                android:fontFamily="@font/ndot57"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_amoled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </ScrollView>

        <!-- Bottom switch bar -->
        <LinearLayout
            android:id="@+id/tab_bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="?attr/colorSurface"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tab_main"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/tab_main"
                android:textSize="13sp"
                android:fontFamily="@font/ndot57"
                android:textColor="?attr/colorOnSurface"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/tab_options"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/tab_options"
                android:textSize="13sp"
                android:fontFamily="@font/ndot57"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:letterSpacing="0.06" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
