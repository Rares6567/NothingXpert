<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="16dp"
	android:background="@drawable/container_single"
	android:baselineAligned="false"
	android:clipToPadding="false"
	android:gravity="center_vertical"
	android:minHeight="72dp"
	android:orientation="horizontal"
	android:paddingStart="?android:attr/listPreferredItemPaddingStart"
	android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
	android:clickable="true"
	android:focusable="true">

	<LinearLayout
		android:id="@+id/icon_frame"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:minWidth="40dp"
		android:minHeight="40dp"
		android:orientation="horizontal"
		tools:ignore="RtlSymmetry">

		<ImageView
			android:background="@drawable/main_preference_icon_bg"
			android:id="@+id/category_icon"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:contentDescription="@android:string/untitled"
			android:scaleType="centerInside"
			android:padding="8dp"
			app:tint="?attr/colorOnSurface" />

	</LinearLayout>

	<RelativeLayout
		android:id="@+id/text_frame"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:paddingStart="16dp"
		android:paddingTop="16dp"
		android:paddingEnd="16dp"
		android:paddingBottom="16dp">

		        <TextView
            android:id="@+id/category_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ndot57"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Lock Screen" />

		<TextView
			android:id="@+id/category_summary"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_below="@id/category_title"
			android:layout_alignStart="@id/category_title"
			android:layout_gravity="start"
			android:alpha="0.8"
			android:maxLines="4"
			android:textAlignment="viewStart"
			android:textAppearance="?android:attr/textAppearanceSmall"
			android:textColor="?attr/colorOnSurfaceVariant" />

	</RelativeLayout>

	<ImageView
		android:layout_width="24dp"
		android:layout_height="24dp"
		android:src="@drawable/ic_chevron_right"
		android:contentDescription="@android:string/untitled"
		app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
